#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# LOAD SETTINGS
#=================================================
ynh_script_progression "Loading installation settings..."

old_core_version=$(ynh_app_setting_get --app=$app --key=core_version)
core_version=$(ynh_app_upstream_version)

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

bazaar_extension=$(ynh_app_setting_get --app=$app --key=bazaar_extension)
if [ ! -z "$bazaar_extension" ]; then
	ynh_app_setting_delete --app=$app --key=bazaar_extension
fi

ssowat_extension=$(ynh_app_setting_get --app=$app --key=ssowat_extension)
if [ ! -z "$ssowat_extension" ]; then
	ynh_hide_warnings ynh_composer_exec remove tituspijean/flarum-ext-auth-ssowat
	ynh_app_setting_delete --app=$app --key=ssowat_extension
fi

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================

# Old installs keep assets either at root or under "public"
if [ -d "$install_dir/assets" ]; then
	ynh_setup_source --dest_dir="$install_dir" --source_id="flarum" --keep="config.php assets public"
else
	ynh_setup_source --dest_dir="$install_dir" --source_id="flarum" --keep="config.php public"
fi

# 1.x config.php stamps generic 'mysql' driver; Flarum 2 needs 'mariadb' on YunoHost's MariaDB
if grep -q "'driver' => 'mysql'" "$install_dir/config.php"; then
	ynh_replace --match="'driver' => 'mysql'" --replace="'driver' => 'mariadb'" --file="$install_dir/config.php"
fi

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_phpfpm

ynh_config_add_nginx

ynh_config_add_logrotate

#=================================================
# ADD SWAP
#=================================================
ynh_script_progression "Adding swap..."

if [ ${PACKAGE_CHECK_EXEC:-0} -eq 0 ]; then
	ynh_add_swap --size=$swap_needed
fi

#=================================================
# COMPOSER AND FLARUM UPGRADE
#=================================================
ynh_script_progression "Installing composer dependencies..."

chown -R $app:www-data $install_dir

if ynh_app_upgrading_from_version_before 1.1.0~ynh1
then
	# Since 1.1, extension version requirements must be "*"
	jq '.require | .[] = "*"' $install_dir/composer.json
fi

pushd $install_dir
	ynh_script_progression "Upgrading Flarum and its extensions..."
	# tituspijean LDAP fork only supports Flarum 1; swap to yippy fork before resolving Flarum 2
	if jq -e '.require["tituspijean/flarum-ext-auth-ldap"]' $install_dir/composer.json >/dev/null 2>&1; then
		ynh_hide_warnings ynh_composer_exec remove tituspijean/flarum-ext-auth-ldap --no-update
	fi
	ynh_hide_warnings ynh_composer_exec require yippy/flarum-ext-auth-ldap:$ldap_version --no-update
	if [[ "$old_core_version" == 1.* ]] && [[ "$core_version" == 2.* ]]; then
		# Flarum 1 locked bundled extensions at exact 1.x; free all flarum/* constraints and force full re-resolution
		jq '.require |= with_entries(if (.key | startswith("flarum/")) then .value = "*" else . end)' $install_dir/composer.json > $install_dir/.composer.json.tmp && cat $install_dir/.composer.json.tmp > $install_dir/composer.json && rm $install_dir/.composer.json.tmp
		ynh_hide_warnings ynh_composer_exec require flarum/core:$core_version --no-update
		ynh_hide_warnings ynh_composer_exec update --prefer-dist --no-dev -a
	else
		ynh_hide_warnings ynh_composer_exec require flarum/core:$core_version --prefer-dist --update-no-dev -a --update-with-all-dependencies
	fi
	ynh_exec_as_app php$php_version flarum migrate
	ynh_exec_as_app php$php_version flarum cache:clear
popd

ynh_app_setting_set --key=core_version --value="$core_version"

#=================================================
# FLARUM EXTENSIONS
#=================================================

# LDAP auth extension setup (idempotent)
activate_flarum_extension -d $db_name -s "yippy-auth-ldap"
ynh_config_add --template="../conf/ldap.sql.template" --destination="../conf/ldap.sql"
ynh_mysql_db_shell $db_name < ../conf/ldap.sql

case $language in
	fr)
	ynh_script_progression "Installing French extension..."
	ynh_hide_warnings ynh_composer_exec require flarum-lang/french:*
	activate_flarum_extension -d $db_name -s "flarum-lang/french"
	sql_command="UPDATE \`settings\` SET \`value\` = 'fr' WHERE \`settings\`.\`key\` = 'default_locale'"
	ynh_mysql_db_shell $db_name <<< "$sql_command;"
	;;
	de)
	ynh_script_progression "Installing German extension..."
	ynh_hide_warnings ynh_composer_exec require flarum-lang/german:*
	activate_flarum_extension -d $db_name -s "flarum-lang/german"
	sql_command="UPDATE \`settings\` SET \`value\` = 'de' WHERE \`settings\`.\`key\` = 'default_locale'"
	ynh_mysql_db_shell $db_name <<< "$sql_command;"
	;;
esac

# Remove deprecated translation plugins
ynh_hide_warnings ynh_composer_exec remove qiaeru/lang-french:*
ynh_hide_warnings ynh_composer_exec remove kakifrucht/flarum-de:*

ynh_print_info "You may need to manually enable your language extension in Flarum's admin panel."

pushd $install_dir
	ynh_exec_as_app php$php_version flarum cache:clear
popd

chmod 750 "$install_dir"
chmod -R o-rwx "$install_dir"
chown -R $app:www-data "$install_dir"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
